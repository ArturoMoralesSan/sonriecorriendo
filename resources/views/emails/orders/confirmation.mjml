        <!-- Detalles de entrega -->
        <mj-section background-color="#ffffff" padding="0 28px 28px">
            <mj-column
                background-color="#fff5fa"
                border-radius="12px"
                padding="18px 20px"
            >
                @php
                    $delivery = $sale->deliveryAddress;

                    $deliveryIsBranch = $delivery
                        && $delivery->delivery_method === \App\Models\DeliveryAddress::METHOD_BRANCH;

                    $deliveryIsHome = $delivery
                        && $delivery->delivery_method === \App\Models\DeliveryAddress::METHOD_HOME;
                @endphp

                @if ($deliveryIsBranch)
                    <mj-text color="#172b4d" font-weight="bold" padding-bottom="8px">
                        Recolección en sucursal
                    </mj-text>

                    <mj-text padding-top="0">
                        <strong>Sucursal:</strong>
                        {{ $delivery->branch_name ?? $delivery->branch?->name ?? 'Sucursal seleccionada' }}
                    </mj-text>

                    @if ($delivery->branch_address)
                        <mj-text padding-top="0">
                            <strong>Dirección:</strong>
                            {{ $delivery->branch_address }}
                        </mj-text>
                    @elseif ($delivery->branch)
                        <mj-text padding-top="0">
                            <strong>Dirección:</strong>
                            {{ $delivery->branch->street }}
                            {{ $delivery->branch->exterior_number }}
                            @if ($delivery->branch->interior_number)
                                , Int. {{ $delivery->branch->interior_number }}
                            @endif
                            , {{ $delivery->branch->neighborhood }}
                            , C.P. {{ $delivery->branch->postal_code }}
                            , {{ $delivery->branch->city }},
                            {{ $delivery->branch->state }}
                        </mj-text>
                    @endif

                    @if ($delivery->branch?->phone)
                        <mj-text padding-top="0">
                            <strong>Teléfono:</strong> {{ $delivery->branch->phone }}
                        </mj-text>
                    @endif

                    @if ($delivery->branch?->opening_time && $delivery->branch?->closing_time)
                        <mj-text padding-top="0">
                            <strong>Horario:</strong>
                            {{ \Illuminate\Support\Carbon::parse($delivery->branch->opening_time)->format('H:i') }}
                            a
                            {{ \Illuminate\Support\Carbon::parse($delivery->branch->closing_time)->format('H:i') }}
                        </mj-text>
                    @endif

                @elseif ($deliveryIsHome)
                    <mj-text color="#172b4d" font-weight="bold" padding-bottom="8px">
                        Entrega a domicilio
                    </mj-text>

                    <mj-text padding-top="0">
                        <strong>Calle:</strong>
                        {{ $delivery->street }}
                        {{ $delivery->exterior_number }}
                        @if ($delivery->interior_number)
                            , Int. {{ $delivery->interior_number }}
                        @endif
                    </mj-text>

                    @if ($delivery->neighborhood)
                        <mj-text padding-top="0">
                            <strong>Colonia:</strong> {{ $delivery->neighborhood }}
                        </mj-text>
                    @endif

                    @if ($delivery->postal_code)
                        <mj-text padding-top="0">
                            <strong>Código postal:</strong> {{ $delivery->postal_code }}
                        </mj-text>
                    @endif

                    <mj-text padding-top="0">
                        <strong>Ciudad:</strong> {{ $delivery->city }}, {{ $delivery->state }}
                    </mj-text>

                    @if ($delivery->references)
                        <mj-text padding-top="0">
                            <strong>Referencias:</strong> {{ $delivery->references }}
                        </mj-text>
                    @endif

                @else
                    <mj-text padding-top="0">
                        No hay información de entrega registrada para este pedido.
                    </mj-text>
                @endif
            </mj-column>
        </mj-section>

        <!-- Pie -->
        <mj-section background-color="#f4f7fb" padding="28px">
